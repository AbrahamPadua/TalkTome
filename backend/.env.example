# Shared secret the app sends as "Authorization: Bearer <token>". Use a long random value.
PROXY_TOKEN=change-me-to-a-long-random-string

# anthropic (default) or openai_compatible
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low, medium, high, xhigh or max
LLM_EFFORT=low
# Seconds to wait for the model before giving up. Slow local models (Ollama on a CPU) may need 300.
LLM_TIMEOUT_SECONDS=80

# Any OpenAI-style /chat/completions endpoint (OpenAI, Ollama, other hosts)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=llama3.1
